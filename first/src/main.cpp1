#include "regUser.h"
#include "user.h"
#include <QApplication>
#include <QPushButton>
#include <QWidget>
#include <iostream>
int main(int argc, char* argv[]) {
  QApplication app(argc, argv);

  QWidget window;
  window.setWindowTitle("Laba1");
  window.resize(1000, 500);

  QPushButton button("Hello world", &window);
  button.resize(300, 150);
  button.move(300, 250);
  window.show();

  return app.exec();
}
