# Checks run by nvim-lint on save.
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-use-trailing-return-type

# Only lint our own headers, not system/libstdc++ headers.
HeaderFilterRegex: 'include/.*'

FormatStyle: file